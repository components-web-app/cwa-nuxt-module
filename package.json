{
  "name": "@cwa/nuxt",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Components Web Apps Nuxt Module. UI for creating component-driven web apps with the API Components Bundle",
  "author": "Daniel West <daniel@silverback.is>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/components-web-app/cwa-nuxt-module.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build && pnpm run tailwind:main && pnpm run tailwind:base && sleep 0.2 && pnpm run copy-layer",
    "prepack": "pnpm build",
    "copy-layer": "copyfiles -e \"./src/layer/**/*.spec.*\"  -u 1 \"./src/layer/**\" dist/",
    "dev": "concurrently --kill-others \"pnpm tailwind:watch\" \"pnpm dev:https\"",
    "dev:https": "npm run dev:prepare && nuxi dev playground --https",
    "dev:http": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:preview": "nuxi preview playground",
    "dev:preview:https": "NITRO_SSL_CERT=$(cat certs/localhost.pem) NITRO_SSL_KEY=$(cat certs/localhost.key.pem) nuxi preview playground",
    "dev:prepare": "pnpm run tailwind:main && pnpm run tailwind:base && nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest --run --reporter=verbose",
    "test:watch": "vitest --watch --reporter=verbose",
    "test:watch:coverage": "vitest --watch --coverage --reporter=verbose",
    "test:coverage": "vitest --run --coverage --reporter=verbose",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "stryker:init": "stryker init",
    "stryker:run": "stryker run",
    "tailwind:main": "postcss src/tailwind/tailwind-cwa.css -o ./src/runtime/templates/assets/cwa.css",
    "tailwind:base": "postcss src/tailwind/tailwind-base.css -o ./src/runtime/templates/assets/base.css",
    "tailwind:watch": "postcss src/tailwind/tailwind-cwa.css -o ./src/runtime/templates/assets/cwa.css --watch"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/robots": "^5.5.5",
    "@nuxtjs/seo": "^3.2.2",
    "@nuxtjs/sitemap": "^7.4.7",
    "@pinia/nuxt": "^0.11.2",
    "@popperjs/core": "^2.11.8",
    "@tailwindcss/vite": "^4.1.13",
    "@vueuse/core": "^13.9.0",
    "consola": "^3.4.2",
    "cookie": "^1.0.2",
    "dayjs": "^1.11.18",
    "defu": "^6.1.4",
    "fast-xml-parser": "^5.2.5",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.21",
    "luxon": "^3.7.2",
    "mitt": "^3.0.1",
    "pinia": "^3.0.3",
    "set-cookie-parser": "^2.7.1",
    "slugify": "^1.6.6",
    "uuid": "^13.0.0",
    "vue": "^3.5.22",
    "vue-input-autowidth": "^2.2.1",
    "vuejs-confirm-dialog": "^0.5.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@headlessui/vue": "^1.7.23",
    "@nuxt/eslint-config": "^1.9.0",
    "@nuxt/kit": "^4.1.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.1.2",
    "@nuxt/test-utils": "3.19.2",
    "@pinia/testing": "^1.0.2",
    "@stryker-mutator/core": "^9.1.1",
    "@stryker-mutator/vitest-runner": "^9.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.1",
    "@types/object-hash": "^3.0.6",
    "@types/set-cookie-parser": "^2.4.10",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "eslint": "^9.36.0",
    "globby": "^14.1.0",
    "happy-dom": "^18.0.1",
    "nuxt": "^4.1.2",
    "pathe": "^2.0.3",
    "playwright-core": "^1.55.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "vitest-environment-nuxt": "^1.0.1",
    "vue-tsc": "^3.1.0"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreCves": [
        "CVE-2025-5889"
      ]
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ],
    "overrides": {
      "linkifyjs@<4.3.2": ">=4.3.2",
      "ipx@>=2.0.0-0 <2.1.1": ">=2.1.1",
      "vite@>=7.1.0 <=7.1.4": ">=7.1.5",
      "nuxt@>=3.6.0 <3.19.0": ">=3.19.0",
      "@nuxt/kit@>=3.6.0 <3.19.0": ">=3.19.0"
    }
  },
  "engines": {
    "pnpm": ">=10.11.0"
  }
}
