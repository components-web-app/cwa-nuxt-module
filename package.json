{
  "name": "@cwa/nuxt",
  "version": "2.0.0-alpha.31",
  "license": "MIT",
  "type": "module",
  "description": "Components Web Apps Nuxt Module. UI for creating component-driven web apps with the API Components Bundle",
  "author": "Daniel West <daniel@silverback.is>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/components-web-app/cwa-nuxt-module.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./layer": "./dist/layer/nuxt.config.ts"
  },
  "main": "./dist/module.mjs",
  "directories": {
    "layer": "./dist/layer"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "bin": {
    "cwa": "bin/cwa.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "pnpm run clean-dist && pnpm run copy-layer && nuxt-module-build build && node scripts/check-declarations.mjs && pnpm run tailwind:main && pnpm run tailwind:base",
    "prepack": "pnpm build",
    "clean-dist": "del dist/",
    "copy-layer": "copyfiles -e \"./src/layer/**/*.spec.*\" -u 1 \"./src/layer/**\" dist/",
    "dev": "concurrently --kill-others \"pnpm tailwind:watch\" \"pnpm dev:https\"",
    "dev:https": "pnpm run dev:prepare && nuxi dev playground --https",
    "dev:http": "pnpm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:preview": "nuxi preview playground",
    "dev:test:types": "cd playground && vue-tsc",
    "dev:preview:https": "NITRO_SSL_CERT=$(cat certs/localhost.pem) NITRO_SSL_KEY=$(cat certs/localhost.key.pem) nuxi preview playground",
    "dev:prepare": "pnpm run tailwind:main && pnpm run tailwind:base && nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest --run --reporter=verbose",
    "test:e2e": "pnpm run dev:build && pnpm run test:e2e:guards",
    "test:e2e:guards": "node test/e2e/entry-bundle-markers.mjs && node test/e2e/prefetch-hints.mjs && node test/e2e/visitor-page-preloads.mjs && node test/e2e/ssr-concurrent-status.mjs && node test/e2e/page-cache-error-headers.mjs && node test/e2e/api-url-not-published.mjs && node test/e2e/sitemap-cache-headers.mjs",
    "test:watch": "vitest --watch --reporter=verbose",
    "test:watch:coverage": "vitest --watch --coverage --reporter=verbose",
    "test:coverage": "vitest --run --coverage --reporter=verbose",
    "test:types": "pnpm run module:test:types && pnpm run dev:test:types",
    "module:test:types": "vue-tsc",
    "stryker:init": "stryker init",
    "stryker:run": "stryker run",
    "tailwind:main": "postcss src/tailwind/tailwind-cwa.css -o ./src/runtime/templates/assets/cwa.css",
    "tailwind:base": "postcss src/tailwind/tailwind-base.css -o ./src/runtime/templates/assets/base.css",
    "tailwind:watch": "postcss src/tailwind/tailwind-cwa.css -o ./src/runtime/templates/assets/cwa.css --watch",
    "test:fresh-install": "node test/e2e/fresh-install.mjs",
    "test:browser": "playwright test -c test/browser/playwright.config.mjs",
    "test:browser:rehearse": "node test/browser/rehearse.mjs"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@internationalized/date": "^3.12.4",
    "@nuxt/kit": "^4.6.0",
    "@nuxt/schema": "^4.6.0",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/seo": "^6.0.1",
    "@nuxtjs/sitemap": "^9.1.0",
    "@pinia/nuxt": "1.0.3",
    "@popperjs/core": "^2.11.8",
    "@vueuse/core": "^15.0.0",
    "consola": "^3.4.2",
    "cookie": "^2.0.1",
    "dayjs": "^1.11.23",
    "defu": "^6.1.7",
    "fast-xml-parser": "^5.11.2",
    "h3": "^1.15.11",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.18.1",
    "mitt": "^3.0.1",
    "nuxt-link-checker": "^6.0.1",
    "nuxt-og-image": "^7.0.7",
    "nuxt-schema-org": "^7.0.1",
    "nuxt-seo-utils": "^9.0.1",
    "nuxt-site-config": "^5.0.3",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "set-cookie-parser": "^3.2.1",
    "slugify": "^1.6.9",
    "uuid": "^14.0.3",
    "vue": "^3.5.44",
    "vue-input-autowidth": "^2.2.1",
    "vuejs-confirm-dialog": "^1.1.0"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "satori": ">=0.47.1"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "satori": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/test-utils": "4.3.4",
    "@oxc-minify/binding-darwin-arm64": "^0.156.0",
    "@oxc-parser/binding-darwin-arm64": "^0.156.0",
    "@oxc-transform/binding-darwin-arm64": "^0.156.0",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/object-hash": "^3.0.6",
    "@types/set-cookie-parser": "^3.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.6",
    "copyfiles": "^2.4.1",
    "del-cli": "^8.0.1",
    "eslint": "^10.13.0",
    "globby": "^16.2.4",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.3",
    "pathe": "^2.0.3",
    "playwright-core": "1.64.1",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "vitest-environment-nuxt": "^2.0.0",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "pnpm": ">=11.5.3"
  }
}
